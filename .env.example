# Optional environment-level default. Most users can connect a provider in the UI.
# Keep keys server-side and never commit this file as .env.
FOODLENS_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# Use FOODLENS_PROVIDER=fixture only for a clearly labeled offline demo.

# Local server configuration.
PORT=8787
HOST=127.0.0.1

# Search budgets are guardrails, not targets.
FOODLENS_BROAD_SEARCH_CALLS=8
FOODLENS_DEEP_SEARCH_CALLS=6

# Browser-connected keys live only in server memory for this many minutes.
FOODLENS_SESSION_TTL_MINUTES=720
FOODLENS_MAX_SESSIONS=100
